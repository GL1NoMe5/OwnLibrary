{
  "name": "cozy-readers-sanctuary",
  "version": "1.3.10",
  "private": true,
  "description": "Атмосферная библиотека и интерактивный дневник читателя",
  "main": "./out/main/index.js",
  "author": "GL1NoMe5",
  "repository": {
    "type": "git",
    "url": "https://github.com/GL1NoMe5/OwnLibrary.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win --publish never",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets:generate": "node scripts/create-illustrations.mjs",
    "format": "prettier --write src tests scripts *.ts *.json *.yml .github/workflows/*.yml"
  },
  "dependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/marck-script": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "fflate": "0.8.3",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sql.js": "1.15.1",
    "three": "0.186.1",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
